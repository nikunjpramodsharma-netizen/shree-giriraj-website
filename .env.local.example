# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# Get these from https://www.sanity.io/manage after creating a project.
# ---------------------------------------------------------------------------

# Your Sanity project ID (found in the project settings on sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id_here"

# Dataset name — use "production"
NEXT_PUBLIC_SANITY_DATASET="production"

# API version — a date string, leave as-is unless you know you need a newer one
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# ---------------------------------------------------------------------------
# Business details used across the site (edit these to your real values)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.shreegiriraj.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="919324974133"
NEXT_PUBLIC_PHONE_PRIMARY="+919324974133"
NEXT_PUBLIC_PHONE_SECONDARY="+919223594133"
NEXT_PUBLIC_EMAIL="shreegiriraj1224@gmail.com"

# ---------------------------------------------------------------------------
# Enquiry delivery
# ---------------------------------------------------------------------------
# Enquiries are emailed, not stored. Without a key the form returns 503 and
# falls back to WhatsApp rather than silently losing a lead.
RESEND_API_KEY=""
# Where enquiries go. Defaults to the site email if unset.
LEAD_TO_EMAIL=""
# The sender. shreegiriraj.com is verified in Resend; the code defaults to
# enquiries@shreegiriraj.com, so leave this empty unless changing it.
LEAD_FROM_EMAIL=""
# The Google Apps Script web app that appends each enquiry to the lead sheet.
# Leave empty and enquiries are emailed only, exactly as before.
LEAD_SHEET_URL=""
